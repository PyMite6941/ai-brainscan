# https://huggingface.co/settings/tokens  (a read token is enough)
# only needed for gated repos like google/gemma-3-*. unsloth/gemma-3-1b-it is ungated.
HF_TOKEN=

# default model for capture. 1b runs on any laptop CPU.
BRAINSCAN_MODEL=unsloth/gemma-3-1b-it

# where scans are written. the UIs only ever read from here.
# BRAINSCAN_ARTIFACTS=./artifacts

# where weights land. keep it OUT of OneDrive / Dropbox / iCloud.
# HF_HOME=~/.cache/huggingface
